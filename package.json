{
  "name": "virgues-roblox-account-manager",
  "version": "1.0.6",
  "description": "A focused Windows desktop account workspace for Roblox profiles.",
  "productName": "Virgue's Roblox Account Manager",
  "author": "Virgue",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "website:dev": "vite --config website/vite.config.js --host localhost --port 4173",
    "website:build": "vite build --config website/vite.config.js",
    "website:preview": "vite preview --config website/vite.config.js --host localhost --port 4173",
    "billing:dev": "node --env-file=billing-api/.env billing-api/server.mjs",
    "package": "npm run build && electron-builder --win nsis --x64",
    "package:publish": "npm run build && electron-builder --win nsis --x64 --publish always",
    "dist": "npm run package"
  },
  "dependencies": {
    "@fontsource/outfit": "5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "electron-updater": "6.8.9",
    "node-llama-cpp": "3.20.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "stripe": "^20.4.1",
    "thinking-orbs": "0.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "com.virgue.robloxaccountmanager",
    "productName": "Virgue's Roblox Account Manager",
    "artifactName": "Virgues-Roblox-Account-Manager-Setup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "Vurdith",
      "repo": "Virgues-Roblox-Account-Manager",
      "releaseType": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bin/nvidia-fps-helper.exe",
        "to": "native/nvidia-fps-helper.exe"
      },
      {
        "from": "native/NVIDIA-NVAPI-LICENSE.txt",
        "to": "native/NVIDIA-NVAPI-LICENSE.txt"
      },
      {
        "from": "native/bin/process-memory-helper.exe",
        "to": "native/process-memory-helper.exe"
      },
      {
        "from": "native/bin/window-input-helper.exe",
        "to": "native/window-input-helper.exe"
      },
      {
        "from": "native/bin/protected-session-helper.exe",
        "to": "native/protected-session-helper.exe"
      },
      {
        "from": "native/ahk-ai-worker.cjs",
        "to": "native/ahk-ai-worker.cjs"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-llama-cpp/**/*",
      "node_modules/@node-llama-cpp/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/virgue-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Virgue's Roblox Account Manager",
      "runAfterFinish": true
    }
  }
}
