# Public website origin(s), comma-separated. Only these origins may call the API.
WEBSITE_ORIGINS=http://localhost:4173,https://virgues-roblox-account-manager.vercel.app

# Server-side only. Never expose these in Vite, Electron, or the website.
DATABASE_URL=postgresql://...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Neon Auth endpoint used by the desktop app and website. The billing API
# verifies the short-lived JWT returned by its /token endpoint.
NEON_AUTH_URL=https://ep-morning-frost-zagg2ox8.neonauth.c-2.eu-west-2.aws.neon.tech/neondb/auth
# Optional: defaults to ${NEON_AUTH_URL}/.well-known/jwks.json.
NEON_AUTH_JWKS_URL=https://ep-morning-frost-zagg2ox8.neonauth.c-2.eu-west-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
# Optional issuer/audience checks. Leave blank unless configured in Neon Auth.
NEON_AUTH_JWT_ISSUER=
NEON_AUTH_JWT_AUDIENCE=

# A recurring multi-currency Stripe Price for Virgue Pro: $10/month USD by
# default, with fixed £10 GBP and €10 EUR currency options.
STRIPE_PRO_PRICE_ID=price_...

# The origin that Stripe redirects to after Checkout and portal use.
PUBLIC_SITE_URL=https://virgues-roblox-account-manager.vercel.app
PORT=8787
