# Public website origin(s), comma-separated. Only these origins may call the API.
VALDOR_WEBSITE_ORIGINS=http://localhost:4173,https://virgues-roblox-account-manager.vercel.app

# Server-side only. Never expose these in Vite, Electron, or the website.
VALDOR_DATABASE_URL=postgresql://...
VALDOR_STRIPE_SECRET_KEY=sk_test_...
VALDOR_STRIPE_WEBHOOK_SECRET=whsec_...

# Neon Auth endpoint used by the desktop app and website. The billing API
# verifies the short-lived JWT returned by its /token endpoint.
VALDOR_NEON_AUTH_URL=https://ep-morning-frost-zagg2ox8.neonauth.c-2.eu-west-2.aws.neon.tech/neondb/auth
# Optional: defaults to ${VALDOR_NEON_AUTH_URL}/.well-known/jwks.json.
VALDOR_NEON_AUTH_JWKS_URL=https://ep-morning-frost-zagg2ox8.neonauth.c-2.eu-west-2.aws.neon.tech/neondb/auth/.well-known/jwks.json
# Optional issuer/audience checks. Leave blank unless configured in Neon Auth.
VALDOR_NEON_AUTH_JWT_ISSUER=
VALDOR_NEON_AUTH_JWT_AUDIENCE=

# A recurring multi-currency Stripe Price for Valdor Pro: $10/month USD by
# default, with fixed £10 GBP and €10 EUR currency options.
VALDOR_STRIPE_PRO_PRICE_ID=price_...

# The origin that Stripe redirects to after Checkout and portal use.
VALDOR_PUBLIC_SITE_URL=https://virgues-roblox-account-manager.vercel.app
VALDOR_PORT=8787

# During migration the server also reads the corresponding VIRGUE_* aliases
# and the original unprefixed names. Set VALDOR_* for new deployments.
