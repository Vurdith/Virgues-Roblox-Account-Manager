# Public website origin(s), comma-separated. Only these origins may call the API.
WEBSITE_ORIGINS=http://localhost:4173,https://app.example.com

# Server-side only. Never expose these in Vite, Electron, or the website.
DATABASE_URL=postgresql://...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Neon Auth endpoint used by the desktop app and website. The billing API
# verifies a user's Better Auth session token against this endpoint.
NEON_AUTH_URL=https://your-neon-auth-endpoint/neondb/auth

# A recurring Stripe Price for Virgue Pro. Create it in Stripe as the $10/month
# base price, then enable/configure any regional pricing in Stripe Dashboard.
STRIPE_PRO_PRICE_ID=price_...

# The origin that Stripe redirects to after Checkout and portal use.
PUBLIC_SITE_URL=http://localhost:4173
PORT=8787
